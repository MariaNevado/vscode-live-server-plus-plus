<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Vexo - Diseño, animación y contenido visual de alta calidad.">
    <meta name="author" content="Vexo">
    <title>Vexo - Inicio</title>
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="icon-180x180.png">
    <style>
        body {
            background-color: #0a0f1e;
            color: #c0c0c0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            opacity: 0;
            transition: opacity 0.5s ease-in;
        }
        body.loaded {
            opacity: 1;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 50px;
            background: rgba(192, 192, 192, 0.2);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }
        .logo {
            font-size: 24px;
            font-weight: bold;
            color: #c0c0c0;
            cursor: pointer;
            transition: transform 0.3s ease-in-out;
        }
        .logo:hover {
            transform: scale(1.1);
        }
        nav a {
            color: #c0c0c0;
            text-decoration: none;
            margin: 0 15px;
            font-size: 16px;
            transition: opacity 0.3s;
        }
        nav a:hover {
            opacity: 0.7;
        }
        .hero {
            text-align: center;
            padding: 150px 20px 80px;
            max-width: 1000px;
            margin: auto;
        }
        .hero h1 {
            font-size: 64px;
            font-weight: 700;
            margin-bottom: 20px;
        }
        .hero p {
            font-size: 22px;
            line-height: 1.6;
            margin-bottom: 40px;
        }
        .hero button {
            background-color: #1e3a8a;
            color: #fff;
            padding: 16px 36px;
            border: none;
            border-radius: 8px;
            font-size: 20px;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
        }
        .hero button:hover {
            background-color: #162c66;
            transform: scale(1.05);
        }
        .section {
            padding: 100px 50px;
            text-align: center;
        }
        .footer {
            text-align: center;
            padding: 30px;
            background: rgba(192, 192, 192, 0.2);
        }
        canvas {
            display: block;
            margin: auto;
        }
        #loading-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7);
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
        }
        .spinner {
            border: 8px solid #f3f3f3;
            border-top: 8px solid #3498db;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 2s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        #progress-bar {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 50%;
            height: 10px;
            background: #fff;
            border-radius: 5px;
            transform: translate(-50%, -50%);
        }
        #progress-bar > div {
            height: 100%;
            width: 0;
            background: #3498db;
            border-radius: 5px;
        }
        @media (max-width: 768px) {
            .hero h1 {
                font-size: 48px;
            }
            .hero p {
                font-size: 18px;
            }
            .hero button {
                padding: 12px 24px;
            }
            .section {
                padding: 50px 20px;
            }
            nav {
                display: block;
                text-align: center;
            }
            nav a {
                display: inline-block;
                margin: 10px 0;
            }
        }
        #logo-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }
        #logo-container .logo {
            font-size: 64px;
            font-weight: bold;
            color: #ffffff;
            transform: perspective(800px) rotateX(30deg) rotateY(30deg);
            animation: rotateLogo 2s forwards;
            opacity: 1;
            transition: transform 2s ease, opacity 2s ease;
        }
        @keyframes rotateLogo {
            0% {
                transform: perspective(800px) rotateX(30deg) rotateY(30deg);
                opacity: 1;
            }
            50% {
                transform: perspective(800px) rotateX(45deg) rotateY(45deg);
                opacity: 0.7;
            }
            100% {
                transform: perspective(800px) rotateX(0deg) rotateY(0deg);
                opacity: 0;
                visibility: hidden;
            }
        }
    </style>
</head>
<body>
    <!-- Pantalla de carga -->
    <div id="loading-screen" role="status" aria-live="polite">
        <div class="spinner" aria-label="Cargando..."></div>
        <div id="progress-bar" aria-label="Barra de progreso">
            <div></div>
        </div>
        <span id="progress-text" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #fff; font-weight: bold;">0%</span>
    </div>

    <!-- Contenedor del logo -->
    <div id="logo-container">
        <div class="logo" role="heading" aria-level="1">Vexo</div>
    </div>

    <!-- Contenido de la página -->
    <header>
        <div class="logo" onclick="window.location.href='index.html'" aria-label="Ir al inicio">VEXO</div>
        <nav>
            <a href="index.html" aria-label="Página de inicio">Inicio</a>
            <a href="servicios.html" aria-label="Nuestros servicios">Servicios</a>
            <a href="contacto.html" aria-label="Contacto">Contacto</a>
            <a href="login.html" aria-label="Acceder a tu cuenta">Acceder</a>
        </nav>
    </header>
    
    <div class="hero">
        <h1>Bienvenido a Vexo</h1>
        <p>Diseño, animación y contenido visual de alta calidad. Creemos en la excelencia y en la creatividad sin límites.</p>
        <button onclick="window.location.href='servicios.html'">Descubre nuestros servicios</button>
    </div>
    
    <div class="section">
        <h2>Logo 3D Interactivo</h2>
        <div id="3d-container"></div>
        <p id="error-message" style="color: red; display: none;">Error al cargar el logo 3D.</p>
    </div>
    
    <footer class="footer">
        <p>&copy; 2025 Vexo. Todos los derechos reservados.</p>
    </footer>

    <!-- Carga asíncrona de los scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/examples/js/loaders/GLTFLoader.js" defer></script>
    <script>
        window.addEventListener('load', async function () {
            const loadingScreen = document.getElementById('loading-screen');
            const progressBar = document.getElementById('progress-bar').firstElementChild;
            const progressText = document.getElementById('progress-text');

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            const renderer = new THREE.WebGLRenderer();
            renderer.setSize(window.innerWidth, window.innerHeight);
            document.getElementById('3d-container').appendChild(renderer.domElement);

            try {
                const loader = new THREE.GLTFLoader();
                await new Promise((resolve, reject) => {
                    loader.load('path_to_logo_model.glb', (gltf) => {
                        const model = gltf.scene;
                        scene.add(model);

                        model.scale.set(0.5, 0.5, 0.5);
                        camera.position.z = 5;
                        resolve();
                    }, (xhr) => {
                        progressBar.style.width = (xhr.loaded / xhr.total * 100) + '%';
                        progressText.textContent = Math.round(xhr.loaded / xhr.total * 100) + '%';
                    }, reject);
                });

                animate();
            } catch (error) {
                console.error(error);
                document.getElementById('error-message').style.display = 'block';
            }

            function animate() {
                requestAnimationFrame(animate);
                renderer.render(scene, camera);
            }

            setTimeout(() => {
                loadingScreen.style.display = 'none';
                document.body.classList.add('loaded');
            }, 3000); // Ajusta el tiempo de carga
        });
    </script>
</body>
</html>
